# 同步服务的配置模板 —— 复制成 .env.local（真实值只写 .env.local，那个文件被 .gitignore 的 .env* 挡住）
# 这里的值一律是占位符，不得写真实口令。

# 业务库（yiwen_anlewo）。**必填**，缺了进程启动即退出。
DATABASE_URL=postgres://__FILL_ME__:__FILL_ME__@127.0.0.1:5432/yiwen_anlewo

# 限流/幂等的计数（只有计数键，没有存档、没有身份）。留空＝用内存实现；连不上也会自动降级。
REDIS_URL=

# 只监听本机，由 Caddy 反代 /api/anlewo/* 进来
PORT=3830
HOST=127.0.0.1

# 额外放行的来源（逗号分隔）。两个正式站与 localhost/127.0.0.1 任意端口总是放行。
# ANLEWO_CORS=https://alanhuang116.github.io,https://kongshan.169-58-39-104.nip.io

# 请求体上限（字节，要大于存档上限 1MB，给 JSON 转义留余量）与限流三档
BODY_LIMIT=2097152
# 每个 uid 每分钟（公平那一维；一台设备正常每分钟 10 次上下）
RATE_PER_MIN=120
# 每个来源地址每分钟（兜底那一维，所有路径共用；不设时默认 max(RATE_PER_MIN×4, 240)）
IP_RATE_PER_MIN=480
# /link 每分钟每个地址能**新建几个身份**（只数真建行；已注册用户开页面报到不占这只桶。
# 注意它限的不是请求数——把请求数当预算，一个 NAT 出口里 25 个陌生人打 401 就能让所有人注册不上）
# 生产建议 10（口径=每 IP 每分真建行数；按实际新用户/分 观察后调）
LINK_PER_MIN=25
# /identity/login 每分钟每个来源地址的**请求**预算。每次登录都要带服务端客户端密钥去敲身份服务
# （那边每验一次要算 bcrypt、还可能发验证码），未登录流量不能无限重放；登录是人手动动作，10 已够宽
LOGIN_PER_MIN=10
# /identity/signup 每分钟每个来源地址的请求预算。留名要花一枚验证码、写一行账号，比登录更重；默认 5
SIGNUP_PER_MIN=5
# /identity/code 每分钟每个来源地址的请求预算。每发一次就是一封真邮件（有成本、也能被拿来骚扰别人邮箱）；默认 10
CODE_PER_MIN=10

# 统一身份对接：开着时必须同时给 IDENTITY_ISSUER（不可写死 localhost）与 IDENTITY_CLIENT_SECRET

# （identity 里 anlewo 这个应用的客户端密钥，只放服务端；浏览器永远拿不到）
IDENTITY_ENABLED=0
IDENTITY_ISSUER=
IDENTITY_CLIENT_ID=anlewo
IDENTITY_CLIENT_SECRET=

# 跨站免登录：登录成功后 identity 的长效 SSO 票写进这枚 cookie。
# 正式给 .iwenxuai.com（六爻/知己读同一枚）；留空＝host-only（本地、IP 访问就是这种）
SSO_COOKIE_DOMAIN=
# 经 https 访问时给 cookie 加 Secure
SSO_COOKIE_SECURE=0
