# 同步服务的配置模板 —— 复制成 .env.local（真实值只写 .env.local，那个文件被 .gitignore 的 .env* 挡住）
# 这里的值一律是占位符，不得写真实口令。

# 业务库（yiwen_anlewo）。**必填**，缺了进程启动即退出。
DATABASE_URL=postgres://__FILL_ME__:__FILL_ME__@127.0.0.1:5432/yiwen_anlewo

# 限流/幂等的计数（只有计数键，没有存档、没有身份）。留空＝用内存实现；连不上也会自动降级。
REDIS_URL=

# 只监听本机，由 Caddy 反代 /api/anlewo/* 进来
PORT=3830
HOST=127.0.0.1

# 额外放行的来源（逗号分隔）。两个正式站与 localhost/127.0.0.1 任意端口总是放行。
# ANLEWO_CORS=https://alanhuang116.github.io,https://kongshan.169-58-39-104.nip.io

# 请求体上限（字节，要大于存档上限 1MB，给 JSON 转义留余量）与限流三档
BODY_LIMIT=2097152
# 每个 uid 每分钟（公平那一维；一台设备正常每分钟 10 次上下）
RATE_PER_MIN=120
# 每个来源地址每分钟（兜底那一维，所有路径共用；不设时默认 max(RATE_PER_MIN×4, 240)）
IP_RATE_PER_MIN=480
# /link 每分钟每个地址能**新建几个身份**（只数真建行；已注册用户开页面报到不占这只桶。
# 注意它限的不是请求数——把请求数当预算，一个 NAT 出口里 25 个陌生人打 401 就能让所有人注册不上）
# 生产建议 10（口径=每 IP 每分真建行数；按实际新用户/分 观察后调）
LINK_PER_MIN=25

# 统一身份对接：本期关闭。开着时必须同时给 IDENTITY_ISSUER（生产 issuer 待确认，不可写死 localhost）
IDENTITY_ENABLED=0
IDENTITY_ISSUER=
