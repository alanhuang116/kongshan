{
  "name": "yiwen-kongshan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "安乐窝 —— 邵雍的桃花源：一幅可以走进去的山水。缘溪过桃林，到草堂、池亭、田畴与邻家；八方即八卦，一日十二时辰各是一卦。不占，只是看。",
  "scripts": {
    "dev": "vite --port 3800 --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3800 --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:motion": "node tests/play/motion.mjs",
    "test:acts": "node tests/play/acts.mjs",
    "fonts": "node tools/fonts.mjs"
  },
  "dependencies": {
    "@fontsource/ma-shan-zheng": "^5.3.1",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "lunar-javascript": "1.7.8",
    "lxgw-wenkai-webfont": "^1.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "4.7.0",
    "playwright-core": "^1.65.0",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  }
}
