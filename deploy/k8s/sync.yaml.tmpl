# 安乐窝同步服务（Deployment + Service）
#
# 应用顺序：先 `sync-migrate-job.yaml.tmpl`（等 job/anlewo-sync-migrate 完成），再 apply 本文件；
# 否则新库上服务会以 503 db_migration_missing 起得来但写不了档，而探活只看 200 是看不出来的。
# 验收：GET /api/anlewo/health 里 schema.tables 与 schema.payloadLimit 都是 "ok"。
apiVersion: apps/v1
kind: Deployment
metadata:
  name: anlewo-sync
  namespace: yiwen
  labels:
    app: anlewo-sync
spec:
  replicas: 1
  revisionHistoryLimit: 3
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  selector:
    matchLabels:
      app: anlewo-sync
  template:
    metadata:
      labels:
        app: anlewo-sync
    spec:
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 30
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: app
          image: yiwen/kongshan-sync:${IMAGE_TAG}
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 3830
              protocol: TCP
          # 非敏感配置（IDENTITY_*、SSO_*、ANLEWO_CORS）在 ConfigMap anlewo-sync-config，
          # 口令类只在 anlewo-sync-env。CM 需先于本模板 apply，否则 Pod 会因缺 CM 起不来。
          envFrom:
            - configMapRef:
                name: anlewo-sync-config
          env:
            - name: NODE_ENV
              value: production
            - name: PORT
              value: "3830"
            - name: HOST
              value: 0.0.0.0
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: anlewo-sync-env
                  key: DATABASE_URL
            # 密钥缺失时为空，等于关闭身份，不会因为模板写死 "0" 而在正式环境静默不上线。
            - name: IDENTITY_CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: anlewo-sync-env
                  key: IDENTITY_CLIENT_SECRET
                  optional: true
            - name: REDIS_URL
              valueFrom:
                secretKeyRef:
                  name: anlewo-sync-env
                  key: REDIS_URL
                  optional: true
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 500m
              memory: 256Mi
          startupProbe:
            httpGet:
              path: /api/anlewo/health
              port: http
            periodSeconds: 5
            failureThreshold: 30
          readinessProbe:
            httpGet:
              path: /api/anlewo/health
              port: http
            periodSeconds: 10
            timeoutSeconds: 5
          livenessProbe:
            httpGet:
              path: /api/anlewo/health
              port: http
            periodSeconds: 20
            timeoutSeconds: 5
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: [ALL]
---
apiVersion: v1
kind: Service
metadata:
  name: anlewo-sync
  namespace: yiwen
spec:
  type: ClusterIP
  selector:
    app: anlewo-sync
  ports:
    - name: http
      port: 3830
      targetPort: http
      protocol: TCP
